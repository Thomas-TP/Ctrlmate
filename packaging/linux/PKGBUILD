# Maintainer: Ctrlmate Contributors
#
# pkgver is kept in sync with the workspace version by scripts/sync_version.py.
# After changing pkgver run `updpkgsums` (pacman-contrib) to replace the checksum, then
# `makepkg --printsrcinfo > .SRCINFO`. Release CI refuses a PKGBUILD whose sha256sums is 'SKIP'.
pkgname=ctrlmate
_repo=Ctrlmate
pkgver=0.7.0
pkgrel=1
pkgdesc="PC telemetry, lighting, cooling and Home Assistant control (daemon, session agent, desktop app)"
arch=('x86_64' 'aarch64')
url="https://github.com/Thomas-TP/Ctrlmate"
license=('AGPL-3.0-or-later')
depends=('gtk3' 'webkit2gtk-4.1' 'hidapi' 'systemd-libs' 'libayatana-appindicator')
makedepends=('cargo' 'bun' 'pkgconf' 'git')
optdepends=('i2c-tools: inspect SMBus buses for DRAM RGB'
            'openrgb: fallback lighting backend for unsupported devices')
install=ctrlmate.install
source=("$_repo-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Placeholder until the release tag exists; run `updpkgsums`.
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/$_repo-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  (cd apps/desktop && bun install --frozen-lockfile)
}

build() {
  cd "$srcdir/$_repo-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  (cd apps/desktop && bun run build)
  cargo build --frozen --release -p ctrlmate-daemon -p ctrlmate-agent -p ctrlmate-desktop
}

check() {
  cd "$srcdir/$_repo-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --workspace
}

package() {
  cd "$srcdir/$_repo-$pkgver"
  local b
  for b in ctrlmated ctrlmate-agent ctrlmate-desktop; do
    install -Dm755 "target/release/$b" "$pkgdir/usr/bin/$b"
  done
  install -Dm644 packaging/linux/ctrlmated.service "$pkgdir/usr/lib/systemd/system/ctrlmated.service"
  install -Dm644 packaging/linux/ctrlmate-agent.service "$pkgdir/usr/lib/systemd/user/ctrlmate-agent.service"
  install -Dm644 packaging/linux/99-ctrlmate.rules "$pkgdir/usr/lib/udev/rules.d/99-ctrlmate.rules"
  install -Dm644 packaging/linux/ctrlmate-i2c.conf "$pkgdir/usr/lib/modules-load.d/ctrlmate-i2c.conf"
  install -Dm644 packaging/linux/ctrlmate.sysusers "$pkgdir/usr/lib/sysusers.d/ctrlmate.conf"
  install -Dm644 packaging/linux/ctrlmate.desktop "$pkgdir/usr/share/applications/ctrlmate.desktop"
  install -Dm644 packaging/linux/ctrlmate-agent.desktop "$pkgdir/etc/xdg/autostart/ctrlmate-agent.desktop"
  install -Dm644 apps/desktop/src-tauri/icons/icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/ctrlmate.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
