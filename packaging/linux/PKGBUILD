# Maintainer: Ctrlmate Contributors
pkgname=ctrlmate
pkgver=0.4.0
pkgrel=1
pkgdesc="Modern PC telemetry, lighting, cooling and system control daemon & desktop app for Home Assistant"
arch=('x86_64' 'aarch64')
url="https://github.com/Thomas-TP/Ctrlmate"
license=('AGPL-3.0-or-later')
depends=('gtk3' 'webkit2gtk-4.1' 'hidapi' 'libpipewire' 'systemd')
makedepends=('cargo' 'bun')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  bun install --cwd apps/desktop --frozen-lockfile
  bun run --cwd apps/desktop build
  cargo build --release -p ctrlmate-daemon -p ctrlmate-desktop
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 target/release/ctrlmated "$pkgdir/usr/bin/ctrlmated"
  install -Dm755 target/release/ctrlmate-desktop "$pkgdir/usr/bin/ctrlmate-desktop"
  install -Dm644 packaging/linux/ctrlmated.service "$pkgdir/usr/lib/systemd/system/ctrlmated.service"
  install -Dm644 packaging/linux/99-ctrlmate.rules "$pkgdir/usr/lib/udev/rules.d/99-ctrlmate.rules"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
