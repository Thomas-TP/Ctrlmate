# Spec template rendered by packaging/linux/pack-linux.sh (placeholders @VERSION@, @ROOT@).
# It packages ALREADY BUILT binaries from target/release (built with --locked in CI).
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none
%define source_date_epoch_from_changelog 0
%define use_source_date_epoch_as_buildtime 1
%define clamp_mtime_to_source_date_epoch 1

Name:           ctrlmate
Version:        @VERSION@
Release:        1%{?dist}
Summary:        PC telemetry, lighting, cooling and Home Assistant control
License:        AGPL-3.0-or-later
URL:            https://github.com/Thomas-TP/Ctrlmate
# Shared libraries (gtk3, webkit2gtk 4.1, hidapi, libudev) are picked up automatically from the ELF files.
Requires:       systemd
Requires(pre):  /usr/sbin/groupadd
Requires(pre):  /usr/sbin/useradd
Recommends:     i2c-tools

%description
Ctrlmate is an open-source PC control suite: hardware telemetry, cooling policy
with a safety watchdog, RGB and Kelvin lighting, and a Home Assistant integration.
This package ships the ctrlmated system daemon (runs as the unprivileged
"ctrlmate" user), the ctrlmate-agent session agent and the desktop application.

%install
install -Dm755 @ROOT@/target/release/ctrlmated %{buildroot}%{_bindir}/ctrlmated
install -Dm755 @ROOT@/target/release/ctrlmate-agent %{buildroot}%{_bindir}/ctrlmate-agent
install -Dm755 @ROOT@/target/release/ctrlmate-desktop %{buildroot}%{_bindir}/ctrlmate-desktop
install -Dm644 @ROOT@/packaging/linux/ctrlmated.service %{buildroot}%{_unitdir}/ctrlmated.service
install -Dm644 @ROOT@/packaging/linux/ctrlmate-agent.service %{buildroot}%{_userunitdir}/ctrlmate-agent.service
install -Dm644 @ROOT@/packaging/linux/99-ctrlmate.rules %{buildroot}%{_prefix}/lib/udev/rules.d/99-ctrlmate.rules
install -Dm644 @ROOT@/packaging/linux/ctrlmate-i2c.conf %{buildroot}%{_prefix}/lib/modules-load.d/ctrlmate-i2c.conf
install -Dm644 @ROOT@/packaging/linux/ctrlmate.desktop %{buildroot}%{_datadir}/applications/ctrlmate.desktop
install -Dm644 @ROOT@/packaging/linux/ctrlmate-agent.desktop %{buildroot}%{_sysconfdir}/xdg/autostart/ctrlmate-agent.desktop
install -Dm644 @ROOT@/apps/desktop/src-tauri/icons/icon.png %{buildroot}%{_datadir}/icons/hicolor/256x256/apps/ctrlmate.png
install -Dm644 @ROOT@/LICENSE %{buildroot}%{_licensedir}/%{name}/LICENSE

%pre
getent group ctrlmate >/dev/null || groupadd -r ctrlmate
getent passwd ctrlmate >/dev/null || \
    useradd -r -g ctrlmate -d /var/lib/ctrlmate -s /sbin/nologin -c "Ctrlmate hardware daemon" ctrlmate
exit 0

%post
modprobe i2c-dev >/dev/null 2>&1 || :
if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules >/dev/null 2>&1 || :
    udevadm trigger --subsystem-match=hidraw --subsystem-match=i2c-dev >/dev/null 2>&1 || :
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    if [ "$1" -eq 1 ]; then
        systemctl enable --now ctrlmated.service >/dev/null 2>&1 || :
    else
        systemctl try-restart ctrlmated.service >/dev/null 2>&1 || :
    fi
fi
echo "ctrlmate: add your user to the 'ctrlmate' group: sudo usermod -aG ctrlmate \"\$USER\""
exit 0

%preun
if [ "$1" -eq 0 ] && [ -d /run/systemd/system ]; then
    systemctl disable --now ctrlmated.service >/dev/null 2>&1 || :
fi
exit 0

%postun
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
fi
if [ "$1" -eq 0 ]; then
    command -v udevadm >/dev/null 2>&1 && udevadm control --reload-rules >/dev/null 2>&1 || :
    # State (/var/lib/ctrlmate: TLS key, pairing, token) and the user are kept on removal, like most daemons.
fi
exit 0

%files
%license %{_licensedir}/%{name}/LICENSE
%{_bindir}/ctrlmated
%{_bindir}/ctrlmate-agent
%{_bindir}/ctrlmate-desktop
%{_unitdir}/ctrlmated.service
%{_userunitdir}/ctrlmate-agent.service
%{_prefix}/lib/udev/rules.d/99-ctrlmate.rules
%{_prefix}/lib/modules-load.d/ctrlmate-i2c.conf
%{_datadir}/applications/ctrlmate.desktop
%config(noreplace) %{_sysconfdir}/xdg/autostart/ctrlmate-agent.desktop
%{_datadir}/icons/hicolor/256x256/apps/ctrlmate.png

%changelog
* Thu Jan 01 2026 Ctrlmate Contributors <noreply@github.com> - @VERSION@-1
- Release @VERSION@, see CHANGELOG.md
