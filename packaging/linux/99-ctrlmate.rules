# Ctrlmate udev rules. Installed to /usr/lib/udev/rules.d/99-ctrlmate.rules.
#
# Scope: ONLY the exact VID:PID pairs Ctrlmate drives, no blanket vendor access.
# Access goes to the `ctrlmate` group (the ctrlmated service user), not to every
# logged-in user. Keep this table in sync with the Rust sources; CI enforces it
# (scripts/check_udev_rules.py).
#
#  VID   PID   Device                                     Source
#  1e71  2007  NZXT Kraken X3 (X53/X63/X73)               crates/ctrlmate-hal/src/kraken.rs
#  1e71  2014  NZXT Kraken X3 (X53/X63/X73)               crates/ctrlmate-hal/src/kraken.rs
#  1e71  3008  NZXT Kraken Z3 (Z53/Z63/Z73)               crates/ctrlmate-hal/src/kraken.rs
#  1e71  300c  NZXT Kraken Elite (2023)                   crates/ctrlmate-hal/src/kraken.rs
#  1e71  300e  NZXT Kraken 2023 (240/280/360)             crates/ctrlmate-hal/src/kraken.rs
#  1e71  3012  NZXT Kraken Elite RGB (2024)               crates/ctrlmate-hal/src/kraken.rs
#  1e71  3014  NZXT Kraken Plus (2024)                    crates/ctrlmate-hal/src/kraken.rs
#  1e71  2012  NZXT RGB Controller (2023)                 crates/ctrlmate-rgb/src/backends/nzxt_rgb.rs
#  1e71  2021  NZXT RGB Controller (2023)                 crates/ctrlmate-rgb/src/backends/nzxt_rgb.rs
#  1e71  2001  NZXT HUE 2                                 crates/ctrlmate-rgb/src/backends/nzxt_rgb.rs
#  1e71  2002  NZXT HUE 2 Ambient                         crates/ctrlmate-rgb/src/backends/nzxt_rgb.rs
#  1e71  2006  NZXT Smart Device V2                       crates/ctrlmate-rgb/src/backends/nzxt_rgb.rs
#  1e71  200d  NZXT Smart Device V2                       crates/ctrlmate-rgb/src/backends/nzxt_rgb.rs
#  1e71  200f  NZXT Smart Device V2                       crates/ctrlmate-rgb/src/backends/nzxt_rgb.rs
#  1e71  2009  NZXT RGB & Fan Controller                  crates/ctrlmate-rgb/src/backends/nzxt_rgb.rs
#  1e71  200e  NZXT RGB & Fan Controller                  crates/ctrlmate-rgb/src/backends/nzxt_rgb.rs
#  1e71  2010  NZXT RGB & Fan Controller                  crates/ctrlmate-rgb/src/backends/nzxt_rgb.rs
#  048d  5702  Gigabyte RGB Fusion 2 (ITE IT5702)         crates/ctrlmate-rgb/src/backends/gigabyte_ite.rs
#  048d  8297  Gigabyte RGB Fusion 2 (ITE IT8297)         crates/ctrlmate-rgb/src/backends/gigabyte_ite.rs
#  048d  5711  Gigabyte RGB Fusion (ITE IT5711)           crates/ctrlmate-rgb/src/backends/gigabyte_ite.rs

ACTION=="remove", GOTO="ctrlmate_end"

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="2007", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="2014", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="3008", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="300c", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="300e", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="3012", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="3014", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="2012", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="2021", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="2001", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="2002", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="2006", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="200d", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="200f", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="2009", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="200e", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="2010", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="048d", ATTRS{idProduct}=="5702", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="048d", ATTRS{idProduct}=="8297", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="048d", ATTRS{idProduct}=="5711", GROUP="ctrlmate", MODE="0660"

# Motherboard SMBus adapters only (AMD PIIX4 / Intel I801) for ENE DRAM RGB.
# GPU, DDC and other I2C buses are deliberately NOT matched: the i2c-dev node
# of an SMBus controller can write DIMM SPD EEPROMs, so access is limited to
# the `ctrlmate` group and to these two adapter families. The match is on the
# adapter name, so it does not depend on a distro-specific `i2c` group.
SUBSYSTEM=="i2c-dev", ATTR{name}=="SMBus PIIX4 adapter*", GROUP="ctrlmate", MODE="0660"
SUBSYSTEM=="i2c-dev", ATTR{name}=="SMBus I801 adapter*", GROUP="ctrlmate", MODE="0660"

LABEL="ctrlmate_end"
